# Normalize line endings to LF in the repository and the working tree on every
# platform. This keeps WSL/Linux git and Windows git (which sets
# core.autocrlf=true) in agreement and prevents whole-tree "modified" churn.
* text=auto eol=lf

# Binary assets: never apply line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.bmp  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
*.keystore binary
*.jks  binary
*.p12  binary

# Windows-only scripts must ship with CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
gradlew.bat text eol=crlf
