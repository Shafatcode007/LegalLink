# Copy to .env (gitignored) and fill in. Never commit real values.
# SUPABASE_ANON_KEY is public by design; every other key here is secret (TRD §9.5).

# --- Flutter app (TRD §15) ---
SUPABASE_URL=http://127.0.0.1:54321     # local values print from `supabase start`
SUPABASE_ANON_KEY=
AI_GATEWAY_URL=http://localhost:8787    # Cloudflare Worker (`wrangler dev`)
AI_PROVIDER=local                       # local | huggingface (switched inside the Worker)
AI_ENABLED=true                         # false -> TemplateAIService only

# --- Worker / Edge Functions only — never in the Flutter app ---
# Worker secrets live in edge/worker/.dev.vars locally and `wrangler secret put` remotely.
SUPABASE_SERVICE_ROLE_KEY=
HF_API_KEY=
LOCAL_LLM_URL=http://localhost:8080/v1/chat/completions   # ai/local_server/hf_server.py
FCM_SERVER_KEY=

# --- GitHub Actions secrets (deploy-web.yml) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
